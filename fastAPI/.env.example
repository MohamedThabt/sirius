# Langfuse Observability Configuration
# Get your keys from https://cloud.langfuse.com -> Settings -> API Keys
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS Configuration
CORS_ORIGINS=https://your-domain.com,http://localhost:8080,http://127.0.0.1:8080

# LiteLLM Proxy URL
# Local development: http://localhost:4000
# Docker/Production: http://litellm-proxy:4000 (default, no need to set)
LITELLM_BASE_URL=http://localhost:4000

# Gemini API Keys (for load balancing across multiple keys)
# Get your keys from https://aistudio.google.com/apikey
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4
GEMINI_API_KEY_5=your-gemini-api-key-5
GEMINI_API_KEY_6=your-gemini-api-key-6
GEMINI_API_KEY_7=your-gemini-api-key-7

# Cerebras API Key (optional)
CEREBRAS_API_KEY=your-cerebras-api-key
