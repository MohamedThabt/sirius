# Copy to fastAPI/src/.env and fill in. Never commit real values.

# Shared secret Laravel sends as a Bearer token (FASTAPI_API_TOKEN in laravel/.env)
SIRIUS_API_TOKEN=

# LiteLLM proxy (see README_PROXY.md)
LITELLM_BASE_URL=http://localhost:4000
LANGGRAPH_PROXY_MODEL=

# Model provider keys, read by src/configllm.yaml
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
CEREBRAS_API_KEY=

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

CORS_ORIGINS=*
DEBUG=false
