# Git
.git
.gitignore
.gitattributes

# Environment files (keep example)
.env*
!.env.example

# Dependencies (installed during build)
node_modules
vendor

# Storage and cache (created at runtime)
storage/
bootstrap/cache/*.php

# Build artifacts (copied from builder stage)
public/build/
public/hot

# Development/Testing
tests/
phpunit.xml
.phpunit.result.cache
phpstan.neon
.php-cs-fixer.cache

# Documentation
README.md
CHANGELOG.md
docs/

# Docker files (not needed in context)
docker-compose*.yml
.docker/

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
