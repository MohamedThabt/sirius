"""
Test environment configuration for Laravel/PHP tests
"""

APP_NAME=DevMind
APP_ENV=testing
APP_KEY=base64:test-key-32-chars-long-here
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=devmind_test
DB_USERNAME=postgres
DB_PASSWORD=secret

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_DRIVER=sync

GOOGLE_API_KEY=test-key-only-for-testing

MAIL_DRIVER=log

INERTIA_ASSET_URL=http://localhost:8000
