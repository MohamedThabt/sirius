# Nginx with baked-in Laravel production configuration
# This is required because Dokploy only pulls images (no git repo context)
FROM nginx:alpine

# Copy the Laravel-specific nginx configuration
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# Create public directory (will be populated via shared volume)
RUN mkdir -p /var/www/public /var/www/storage

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
