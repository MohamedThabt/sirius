#!/bin/bash

main() {
    echo "=========================================="
    echo "Starting Laravel application..."
    echo "Working directory: $(pwd)"
    echo "User: $(whoami)"
    echo "PHP version: $(php --version | head -1)"
    echo "Entrypoint Version: 2025-12-27-FIXED-PERMISSIONS"
    echo "=========================================="
    
    # Log entrypoint start
    echo "ENTRYPOINT_START: $(date -Iseconds)" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    echo "ENV_APP_URL: ${APP_URL:-NOT_SET}" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    echo "ENV_SESSION_SECURE: ${SESSION_SECURE_COOKIE:-NOT_SET}" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    
    # Enable strict error handling
    set -e
    
    echo "Step 1: Preparing file permissions..."
    prepare_file_permissions
    
    echo "Step 2: Preparing storage..."
    prepare_storage
    
    echo "Step 3: Waiting for database..."
    wait_for_db
    
    echo "Step 4: Running migrations..."
    run_migrations
    
    echo "Step 5: Running seeders..."
    run_seeders
    
    echo "Step 6: Optimizing app..."
    optimize_app
    
    echo "Step 7: Starting server..."
    run_server "$@"
}

prepare_file_permissions() {
    # Make artisan executable if it isn't already
    if [ ! -x "./artisan" ]; then
        echo "Making artisan executable..."
        chmod a+x ./artisan
    else
        echo "Artisan is already executable, skipping..."
    fi
    
    # Set specific permissions for storage and cache directories
    if [ -d "/var/www/storage" ]; then
        chmod -R 777 /var/www/storage
        echo "Storage directory permissions set"
    fi
    
    if [ -d "/var/www/bootstrap/cache" ]; then
        chmod -R 777 /var/www/bootstrap/cache
        echo "Bootstrap cache directory permissions set"
    fi
}

prepare_storage() {
    echo "Preparing Laravel storage directories..."
    
    # Create required directories for Laravel
    mkdir -p /var/www/storage/framework/cache/data
    mkdir -p /var/www/storage/framework/sessions
    mkdir -p /var/www/storage/framework/views
    mkdir -p /var/www/storage/app/public
    mkdir -p /var/www/storage/logs

    # Set permissions for the storage directory (skip chown - we're running as www-data already)
    if chmod -R 777 /var/www/storage 2>/dev/null; then
        echo "Storage permissions set successfully"
    else
        echo "Warning: Failed to set storage permissions, continuing..."
    fi

    # Copy assets to volume if it exists
    if [ -d "/assets_volume" ]; then
        cp -r /var/www/public/. /assets_volume/
        echo "Assets copied to volume"
    fi
    
    # Ensure the symlink exists (only if it doesn't already exist)
    if [ ! -L "public/storage" ]; then
        echo "Creating storage symlink..."
        if php artisan storage:link; then
            echo "Storage symlink created successfully"
        else
            echo "Warning: Failed to create storage symlink, continuing..."
        fi
    else
        echo "Storage symlink already exists, skipping..."
    fi
}


wait_for_db() {
    echo "Waiting for database to be ready..."
    local max_attempts=30
    local attempt=1
    
    while [ $attempt -le $max_attempts ]; do
        # Try to connect to database - this will work even if migrations haven't run yet
        if ./artisan tinker --execute="DB::connection()->getPdo();" 2>/dev/null; then
            echo "Database is ready!"
            return 0
        fi
        
        echo "Database not ready, attempt $attempt/$max_attempts..."
        sleep 2
        ((attempt++))
    done
    
    echo "Database connection failed after $max_attempts attempts"
    exit 1
}

run_migrations() {
    ./artisan migrate --force
}

run_seeders() {
    echo "Running database seeders..."
    ./artisan db:seed --force
}

optimize_app() {
    echo "Optimizing Laravel application..."
    
    # Log before optimize
    echo "OPTIMIZE_START: $(date -Iseconds)" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    echo "BEFORE_APP_URL: $(php artisan tinker --execute='echo config("app.url");' 2>/dev/null || echo 'ERROR')" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    
    # Clear any existing caches first
    ./artisan optimize:clear
    
    ./artisan optimize
    
    # Log after optimize
    echo "AFTER_APP_URL: $(php artisan tinker --execute='echo config("app.url");' 2>/dev/null || echo 'ERROR')" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    echo "OPTIMIZE_END: $(date -Iseconds)" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
}

run_server() {
    echo "SERVER_START: $(date -Iseconds)" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    echo "ENTRYPOINT_COMPLETE: $(date -Iseconds)" >> /var/www/storage/logs/entrypoint.log 2>&1 || true
    exec /usr/local/bin/docker-php-entrypoint "$@"
}

main "$@"